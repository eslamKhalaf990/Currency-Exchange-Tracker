  },
  "item": [
    {
      "name": "1. Get Latest Rates",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://latest.currency-api.pages.dev/v1/currencies/{{base_currency}}.json",
          "protocol": "https",
          "host": [
            "latest",
            "currency-api",
            "pages",
            "dev"
          ],
          "path": [
            "v1",
            "currencies",
            "{{base_currency}}.json"
          ]
        },
        "description": "Fetches the most recent exchange rates. Returns EGP to other currencies."
      },
      "response": []
    },
    {
      "name": "2. Get Yesterday's Rates (Daily Change)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://{{yesterday_date}}.currency-api.pages.dev/v1/currencies/{{base_currency}}.json",
          "protocol": "https",
          "host": [
            "{{yesterday_date}}",
            "currency-api",
            "pages",
            "dev"
          ],
          "path": [
            "v1",
            "currencies",
            "{{base_currency}}.json"
          ]
        },
        "description": "Fetches rates from exactly one day ago to compute the 24-hour difference."
      },
      "response": []
    },
    {
      "name": "3. Get Historical Rates (7-Day Chart Point)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://{{historical_date}}.currency-api.pages.dev/v1/currencies/{{base_currency}}.json",
          "protocol": "https",
          "host": [
            "{{historical_date}}",
            "currency-api",
            "pages",
            "dev"
          ],
          "path": [
            "v1",
            "currencies",
            "{{base_currency}}.json"
          ]
        },
        "description": "Fetches rates for a specific historical date to build the 7-day line chart data points."
      },
      "response": []
    }
  ],
