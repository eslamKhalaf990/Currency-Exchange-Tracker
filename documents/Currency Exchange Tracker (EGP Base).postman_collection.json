    "name": "Currency Exchange Tracker (EGP Base)",
    "description": "API collection for the Currency Exchange Tracker assignment. Base currency is strictly EGP.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "18989765",
